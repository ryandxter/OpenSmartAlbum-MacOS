{
  "mode": "interactive",
  "granularity": "standard",
  "aas_integration": true,
  "aas_version": "15.12.0",
  "parallelization": {
    "enabled": true,
    "plan_level": true,
    "task_level": false,
    "skip_checkpoints": true,
    "max_concurrent_agents": 4,
    "min_plans_for_parallel": 2
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": false,
    "nyquist_validation": true,
    "pattern_mapper": true,
    "ui_phase": true,
    "ui_safety_gate": true,
    "code_review": true,
    "code_review_depth": "standard",
    "ui_review": true,
    "inline_plan_threshold": 0,
    "use_worktrees": true,
    "subagent_timeout": 600000,
    "text_mode": false,
    "research_before_questions": false,
    "skip_discuss": false
  },
  "worktree": {
    "baseRef": "head"
  },
  "model_profile": "adaptive",
  "planning": {
    "commit_docs": true,
    "search_gitignored": false,
    "sub_repos": []
  },
  "git": {
    "branching_strategy": "none",
    "create_tag": true
  },
  "gates": {
    "confirm_project": true,
    "confirm_phases": true,
    "confirm_roadmap": true,
    "confirm_breakdown": true,
    "confirm_plan": true,
    "execute_next_plan": true,
    "issues_review": true,
    "confirm_transition": true
  },
  "safety": {
    "always_confirm_destructive": true,
    "always_confirm_external_services": true
  },
  "project_code": "OSAM",
  "project_name": "OpenSmartAlbum-MacOS"
}

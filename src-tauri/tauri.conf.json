{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenSmartAlbum",
  "version": "1.0.77",
  "identifier": "com.opensmartalbum.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenSmartAlbum",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#18181b",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://github.com https://objects.githubusercontent.com; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https://avatars.githubusercontent.com;",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/thumbnails/**", "$APPCACHE/previews/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": null,
        "windowPosition": {
          "x": 400,
          "y": 200
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerHooks": "hooks.nsh",
        "compression": "lzma"
      }
    },
    "fileAssociations": [
      {
        "ext": ["afsn", "opensmartalbum"],
        "name": "OpenSmartAlbum Project",
        "description": "OpenSmartAlbum Project File",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFRUNEM0VDREYyQjk1NkYKUldSdmxTdmY3TlBzemltaWxGQm8wczFVa29wMVcxRGNkRGtaWTU2c3p5RURDZ1Q2YUxHdWIvaE0K",
      "endpoints": [
        "https://github.com/asrofims/AFSNSmartAlbum/releases/latest/download/latest.json"
      ]
    }
  }
}
